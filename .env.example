# Set variables in the process environment; no dotenv dependency is needed.
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://127.0.0.1:3000
DATABASE_PATH=.data/nexora.sqlite
# In production: NODE_ENV=production and PUBLIC_ORIGIN=https://your-domain
# Confirmed operating country: United States. Customer account balances use USD.
# Bank-transfer and cryptocurrency funding providers are not integrated yet.

# Vercel only, after deploying the backend: BACKEND_ORIGIN=https://your-service.onrender.com
